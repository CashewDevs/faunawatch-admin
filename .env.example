# Supabase configuration — replace with your project values.
# See: https://supabase.com/docs/guides/getting-started
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox public token (starts with pk.) for the post location map. Use an
# admin-only token limited to the admin site's URLs in the Mapbox dashboard.
# Optional: without it the map shows "Map unavailable".
VITE_MAPBOX_TOKEN=your-mapbox-public-token
